[
  {
    "id": "aws-access-key-id",
    "description": "AWS access key ID",
    "severity": "HIGH",
    "regex": "\\b(AKIA|ASIA)[0-9A-Z]{16}\\b"
  },
  {
    "id": "aws-secret-access-key",
    "description": "AWS secret access key",
    "severity": "HIGH",
    "regex": "(?i)aws_secret_access_key\\s*[:=]\\s*['\"]?[A-Za-z0-9/+=]{40}['\"]?"
  },
  {
    "id": "github-token",
    "description": "GitHub personal access / OAuth / app token",
    "severity": "HIGH",
    "regex": "\\bgh[pousr]_[A-Za-z0-9]{36,255}\\b"
  },
  {
    "id": "gitlab-pat",
    "description": "GitLab personal access token",
    "severity": "HIGH",
    "regex": "\\bglpat-[A-Za-z0-9_-]{20}\\b"
  },
  {
    "id": "slack-token",
    "description": "Slack API token",
    "severity": "HIGH",
    "regex": "\\bxox[baprs]-[0-9A-Za-z-]{10,48}\\b"
  },
  {
    "id": "slack-webhook-url",
    "description": "Slack incoming webhook URL",
    "severity": "MEDIUM",
    "regex": "https://hooks\\.slack\\.com/services/[A-Za-z0-9/]+"
  },
  {
    "id": "google-api-key",
    "description": "Google API key",
    "severity": "MEDIUM",
    "regex": "\\bAIza[0-9A-Za-z_-]{35}\\b"
  },
  {
    "id": "stripe-live-key",
    "description": "Stripe live secret key",
    "severity": "CRITICAL",
    "regex": "\\bsk_live_[0-9A-Za-z]{24,}\\b"
  },
  {
    "id": "npm-token",
    "description": "npm publish token",
    "severity": "HIGH",
    "regex": "\\bnpm_[A-Za-z0-9]{36}\\b"
  },
  {
    "id": "private-key-block",
    "description": "Embedded private key block",
    "severity": "CRITICAL",
    "regex": "-----BEGIN\\s?(RSA|EC|DSA|OPENSSH)?\\s?PRIVATE KEY-----"
  },
  {
    "id": "generic-password-assignment",
    "description": "Hardcoded password assignment",
    "severity": "LOW",
    "regex": "(?i)\\b(password|passwd|pwd)\\s*[:=]\\s*['\"][^'\"\\s]{8,}['\"]"
  }
]
